# Nexo Fiscal — Environment variables (example).
# Copy to .env.local and adjust for your environment.
# NEVER commit .env or .env.local.

# ============================================================================
# Database (docker-compose postgres)
# ============================================================================
POSTGRES_DB_NAME=nexofiscal_dev
POSTGRES_ROOT_PASSWORD=postgres_root_dev
APP_USER_PASSWORD=app_user_dev_pass
APP_ADMIN_PASSWORD=app_admin_dev_pass

# Connection strings consumed by Prisma / NestJS
DATABASE_URL="postgresql://app_user:app_user_dev_pass@localhost:5434/nexofiscal_dev?schema=public&connection_limit=10"
DATABASE_ADMIN_URL="postgresql://app_admin:app_admin_dev_pass@localhost:5434/nexofiscal_dev?schema=public&connection_limit=5"

# ============================================================================
# Auth — Clerk Organizations (Plan 02-09 RELIGOU; default após período protótipo)
# Provisionar app dev em https://dashboard.clerk.com (CLERK_SETUP.md seções 1-5).
# Sem chaves válidas, o build passa graças ao fallback publishableKey, mas login real
# não funciona. CLERK_SECRET_KEY inválida no apps/api rejeita todos os JWTs.
# ============================================================================
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_REPLACE_ME
CLERK_SECRET_KEY=sk_test_REPLACE_ME
# svix webhook secret — Clerk Dashboard > Webhooks (sync User/Org/Membership)
CLERK_WEBHOOK_SECRET=whsec_REPLACE_ME
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/entrar
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/cadastrar
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/app/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/app/dashboard
NEXT_PUBLIC_API_URL=http://localhost:3001

# ============================================================================
# Auth fallback — Modo protótipo single-user (cookie HMAC) — OPT-IN
# USE_PROTOTYPE_AUTH=true ativa o gate HMAC como rollback de emergência caso
# Clerk fique indisponível. Default false; default Plan 02-09 é Clerk.
# Ver docs/CLERK_SETUP.md seção 10 ("Rollback para modo protótipo").
# AUTH_SECRET ≥ 16 chars; em prod é obrigatório (erro se ausente).
# ============================================================================
USE_PROTOTYPE_AUTH=false
AUTH_EMAIL=admin@nexofiscal.com.br
AUTH_PASSWORD=nexo2026
AUTH_SECRET=change-me-to-a-random-32-char-string-min

# ============================================================================
# AWS S3 (Object Lock) — Plan 08 scaffolds, user provisions bucket
# ============================================================================
AWS_REGION=sa-east-1
AWS_ACCESS_KEY_ID=REPLACE_ME
AWS_SECRET_ACCESS_KEY=REPLACE_ME
S3_BUCKET_FISCAL=nexofiscal-fiscal-dev
S3_BUCKET_CERTS=nexofiscal-certs-dev
# KMS CMK alias para Server-Side Encryption (ex: alias/nexofiscal-prod). Vazio em dev.
AWS_KMS_KEY_ID=
# Em prod, setar STRICT_OBJECT_LOCK=true para abortar o bootstrap caso o bucket
# fiscal NÃO tenha Object Lock COMPLIANCE com retenção >= 6 anos (FOUND-11).
STRICT_OBJECT_LOCK=false

# ============================================================================
# Observability — Sentry + OpenTelemetry (Plan 01-10 scaffold)
# Com DSN/endpoint VAZIOS, SDKs são no-op (ConsoleSpanExporter em dev).
# Produção provisiona via Secret Manager. Ver docs/OBSERVABILITY.md.
# ============================================================================
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0.1
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=development
# OTLP collector (vazio em dev → ConsoleSpanExporter; prod → ADOT/SigNoz/Grafana Tempo)
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=nexofiscal-api
# STRICT_SENTRY=true aborta boot se DSN ausente em prod (atualmente no-op aviso-warning)
STRICT_SENTRY=false

# ============================================================================
# App
# ============================================================================
NODE_ENV=development
APP_URL=http://localhost:3000
API_URL=http://localhost:3333
LOG_LEVEL=debug

# ============================================================================
# Dev override (apps/api) — permite headers x-user-id/x-role em E2E sem JWT.
# SOMENTE em NODE_ENV=development; em prod o flag é ignorado pelo ClerkGuard.
# Útil para smoke tests roles-guard-rbac.spec.ts sem provisionar Clerk.
# ============================================================================
ALLOW_HEADER_AUTH=true
