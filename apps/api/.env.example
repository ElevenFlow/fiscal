# apps/api — Environment variables (example)
# Copy to .env.local.

# ============================================================================
# Database (NestJS + Prisma — runtime usa app_user NOBYPASSRLS)
# ============================================================================
DATABASE_URL="postgresql://app_user:app_user_dev_pass@localhost:5434/nexofiscal_dev?schema=public&connection_limit=10"
DATABASE_ADMIN_URL="postgresql://app_admin:app_admin_dev_pass@localhost:5434/nexofiscal_dev?schema=public&connection_limit=5"

# ============================================================================
# Auth in-house (Phase 02.1 — substitui @clerk/backend)
#
# AUTH_JWT_SECRET: secret HS256 para assinar access tokens JWT (cookie nf_access).
#   - Minimo 32 caracteres. Em producao: AWS Secrets Manager ou similar.
#   - Gerar: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#     ou:   openssl rand -hex 32
#   - Fail-fast em producao se ausente (env.schema.ts valida no bootstrap).
#   - O mesmo valor deve ser usado em apps/api e apps/web.
#
# ALLOW_HEADER_AUTH: Em producao SEMPRE false. Em dev local true permite
#   headers x-user-id/x-role para integration tests sem JWT real.
# ============================================================================
AUTH_JWT_SECRET=change-me-32-chars-min-replace-via-secrets-manager-in-prod
ALLOW_HEADER_AUTH=true

# ============================================================================
# App
# ============================================================================
NODE_ENV=development
PORT=3001
LOG_LEVEL=debug

# ============================================================================
# AWS S3 + KMS (Plan 01-08 e Phase 2 cert pipeline)
# ============================================================================
AWS_REGION=sa-east-1
AWS_ACCESS_KEY_ID=REPLACE_ME
AWS_SECRET_ACCESS_KEY=REPLACE_ME
S3_BUCKET_FISCAL=nexofiscal-fiscal-dev
S3_BUCKET_CERTS=nexofiscal-certs-dev
AWS_KMS_KEY_ID=
STRICT_OBJECT_LOCK=false

# ============================================================================
# Certificado A1 — KMS envelope encryption (Plan 02-04)
# Em prod/staging, KMS_CERT_KEY_ID E OBRIGATORIO (boot falha fechado).
# Em dev, deixar vazio E setar DEV_MASTER_KEY (32 bytes hex / 64 chars) para
# fallback HMAC deterministico — nao usa AWS, nao exige LocalStack.
# DEV_MASTER_KEY JAMAIS deve ser commitada com valor real; gere com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ============================================================================
KMS_CERT_KEY_ID=
DEV_MASTER_KEY=

# ============================================================================
# BullMQ / Redis (Plan 02-05 — cron de alertas certificado A1, Phase 3+ jobs)
# Em dev: aponta para Redis local subido via docker-compose (porta 6380).
# Em prod/staging: ElastiCache (rediss:// com TLS obrigatorio).
# Se vazio, scheduler/processor vira NO-OP (modo dev sem Redis) — endpoints REST
# de alertas continuam funcionando mas o cron diario nao roda.
# ============================================================================
REDIS_URL=redis://localhost:6380

# ============================================================================
# Observability — Sentry + OTel
# ============================================================================
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0.1
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=nexofiscal-api
STRICT_SENTRY=false
