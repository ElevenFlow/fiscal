# apps/web — Environment variables (example)
# Copy to .env.local. Phase 02.1 substituiu Clerk por auth in-house.

# ============================================================================
# Auth in-house (Phase 02.1)
#
# AUTH_JWT_SECRET: secret HS256 para verificar cookies nf_access no middleware.
#   - Deve ser o MESMO valor que em apps/api.
#   - Mínimo 32 caracteres. Em produção: AWS Secrets Manager ou similar.
#   - Gerar: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#     ou:   openssl rand -hex 32
# ============================================================================
AUTH_JWT_SECRET=change-me-32-chars-min-replace-via-secrets-manager-in-prod

# ============================================================================
# API URL (apps/web fetchApi proxia para apps/api com Bearer JWT in-house)
# ============================================================================
NEXT_PUBLIC_API_URL=http://localhost:3001

# ============================================================================
# Sentry (Plan 01-10) — DSN vazio = no-op
# ============================================================================
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=development
