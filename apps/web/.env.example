# apps/web — Environment variables (example)
# Copy to .env.local. Plan 02-09 religou Clerk como auth default.

# ============================================================================
# Clerk (default auth — Plan 02-09)
# Provisionar em https://dashboard.clerk.com (CLERK_SETUP.md seções 1-5).
# ============================================================================
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_REPLACE_ME
CLERK_SECRET_KEY=sk_test_REPLACE_ME
CLERK_WEBHOOK_SECRET=whsec_REPLACE_ME
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/entrar
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/cadastrar
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/app/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/app/dashboard

# Webhook usa app_admin (BYPASSRLS) para upsert users/contabilidades/user_memberships
DATABASE_ADMIN_URL="postgresql://app_admin:app_admin_dev_pass@localhost:5434/nexofiscal_dev?schema=public&connection_limit=2"

# ============================================================================
# API URL (apps/web fetchApi proxia para apps/api com Bearer JWT do Clerk)
# ============================================================================
NEXT_PUBLIC_API_URL=http://localhost:3001

# ============================================================================
# Auth fallback (Plan 02-09 — opt-in para emergência via cookie HMAC)
# Default false. Quando true, clerk-shim.ts roteia para session.ts.
# Rollback completo (sem Clerk): consultar docs/CLERK_SETUP.md seção 10.
# ============================================================================
USE_PROTOTYPE_AUTH=false
AUTH_EMAIL=admin@nexofiscal.com.br
AUTH_PASSWORD=nexo2026
AUTH_SECRET=change-me-to-a-random-32-char-string-min

# ============================================================================
# Sentry (Plan 01-10) — DSN vazio = no-op
# ============================================================================
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=development
